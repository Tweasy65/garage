# Copy to .env.local for local dev (development instance keys).
# Production keys: npx clerk env pull --instance prod --file .env.production.local

# Clerk — barton-home application (dev: pk_test_ / sk_test_)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional comma-separated extra Clerk authorized parties (preview/staging origins)
# VITE_CLERK_AUTHORIZED_PARTIES=https://preview.example.com

# Neon Postgres — use the pooled `-pooler` host for Workers
DATABASE_URL=
